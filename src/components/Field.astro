---
// Renders a frontmatter string; a TODO value is highlighted in dev and omitted in the public build.
import { showTodos, isTodo } from '../lib/todo';
const { value } = Astro.props as { value: string };
---
{isTodo(value)
  ? showTodos && <mark class="todo" data-todo>{value.replace(/^TODO[\s:—-]*/, '')}</mark>
  : value}
