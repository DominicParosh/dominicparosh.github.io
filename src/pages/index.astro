---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Ask from '../components/Ask.astro';
import Field from '../components/Field.astro';
import { showTodos, isTodo } from '../lib/todo';
import { experience, education, papers, profile, skills } from '../data/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="hero">
    <div>
      <p class="hero-name">{profile.name}, {profile.role}</p>
      <h1>I build LLM systems that know when they're wrong.</h1>
      <p class="hero-lede">
        I've built machine learning systems since 2018. At Verizon I engineered GenTaaS, an AI
        testing platform that cut test-case turnaround by about 40%, with evaluation built in from
        the start: LLM-as-a-judge scoring, golden datasets and review by subject-matter experts.
      </p>
      <p class="hero-lede">
        In research I work on evidence-grounded extraction: every fact a model pulls out should
        come with its evidence, and when there isn't any, the model should decline.
      </p>
    </div>
    <Ask />
  </section>

  <section class="section" id="work" aria-labelledby="work-h">
    <h2 id="work-h">Selected work</h2>
    <ul class="work-list">
      {work.map((w) => (
        <li class="work-item">
          <h3><a href={`/work/${w.id}/`}>{w.data.title}</a></h3>
          <p class="work-meta">{w.data.kind}, {w.data.where}. {w.data.stack.slice(0, 4).join(', ')}</p>
          <p class="work-summary">{w.data.summary}</p>
          {(showTodos || !isTodo(w.data.outcome)) && <p class="work-outcome"><Field value={w.data.outcome} /></p>}
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="research-h">
    <h2 id="research-h">Research</h2>
    <div>
      <ul class="plain">
        {papers.map((p) => (
          <li><Field value={p.title} /> <span class="entry-meta">({p.venue})</span></li>
        ))}
      </ul>
      <p><a href="/research/">Publications, research projects and interests</a></p>
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="exp-h">
    <h2 id="exp-h">Experience</h2>
    <div class="entries">
      {experience.map((e) => (
        <article class="entry">
          <h3>{e.title}</h3>
          <p class="entry-meta">{e.org}, {e.place}. {e.period}</p>
          <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
        </article>
      ))}
      <article class="entry">
        <h3>Education</h3>
        <ul class="plain">
          {education.map((ed) => <li>{ed.degree}, {ed.school} <span class="entry-meta">({ed.period})</span></li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-h">
    <h2 id="skills-h">Tools</h2>
    <dl class="skills">
      {skills.map((g) => (<div><dt>{g.group}</dt><dd>{g.items}</dd></div>))}
    </dl>
  </section>

  <section class="section" aria-labelledby="more-h">
    <h2 id="more-h">Everything else</h2>
    <p class="prose-block">
      Twenty-odd smaller repositories, from RAG experiments to a GPT written from scratch, are in
      the <a href="/archive/">archive</a>.
    </p>
  </section>
</Base>
