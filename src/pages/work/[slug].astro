---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Todo from '../../components/Todo.astro';
import Field from '../../components/Field.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <header class="case-head">
    <a class="back" href="/#work">All work</a>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <dl class="facts">
      <div class="outcome"><dt>Outcome</dt><dd><Field value={d.outcome} /></dd></div>
      <div><dt>My role</dt><dd><Field value={d.role} /></dd></div>
      <div><dt>Where and when</dt><dd>{d.where}, <Field value={d.period} /></dd></div>
      <div><dt>Built with</dt><dd>{d.stack.join(', ')}</dd></div>
      {d.links.length > 0 && (
        <div><dt>Links</dt><dd>{d.links.map((l) => <a href={l.href}>{l.label}</a>)}</dd></div>
      )}
    </dl>
  </header>
  <article class="case-body">
    <Content components={{ Todo }} />
  </article>
</Base>
